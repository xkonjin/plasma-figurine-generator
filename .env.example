# Google AI Studio API Key (Gemini)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Vercel KV (optional - for persistent gallery storage)
# These are automatically set when you add Vercel KV to your project
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Authentication
AUTH_SECRET=your-auth-secret-here
RESEND_API_KEY=your-resend-api-key

# Plasma USDT0 Configuration
PLASMA_RPC=https://rpc.plasma.to
PLASMA_CHAIN_ID=9745
MERCHANT_ADDRESS=0xYourMerchantWalletAddress

# Payment Configuration
FIGURINE_PRICE=0.10
USE_DYNAMIC_PRICING=true

# Gasless API (Optional)
PLASMA_RELAYER_URL=https://api.plasma.to
PLASMA_RELAYER_SECRET=your-relayer-secret
USE_GASLESS_API=true

# Rate Limiting
ENABLE_RATE_LIMITING=true

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,https://your-domain.com
